# Copia este archivo a `.env` y completa los valores reales.

# ===== Seguridad =====
DJANGO_SECRET_KEY=genera-una-clave-aleatoria-larga
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ===== Stripe (panel.stripe.com) =====
# 1. MODO TEST: Developers -> API keys
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# 2. Developers -> Webhooks -> crea uno para checkout.session.completed,
#    invoice.payment_succeeded y invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# ===== Precios Stripe =====
# 3. Productos -> crea "Premium Mensual" ($9.99/mes) y "Premium Anual" ($99.99/año)
#    tipo Subscription, y pega sus IDs (empiezan con "price_")
STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_ID_PREMIUM_YEARLY=price_xxxxxxxxxxxxx